msgctxt "9e8d90c70c3743ada804e3d099e5dd56"
msgid ""
"དེ་ལྟ་ བུ་␣འི་ རྒྱུད་སྡེ་ བཞི་པོ་ དེ་ རང་ གང་ཡིན་ སྙམ་ ན །  བྱ་བ་␣འི་ རྒྱུད་"
" དང་ །  སྤྱོད་པ་␣འི་ རྒྱིད་ དང་ །  རྣལ་འབྱོར་ གྱི་ རྒྱུད་ དང་ བླ་མེད་ རྒྱུད "
"།"
msgstr ""
"Four sections of Tantra are Kriya Tantra, Charya Tantra, Yoga Tantra, and "
"Anuttara Tantra."

msgctxt "dcd6c989193a485fb443acb606a7778a"
msgid "དང་པོ་␣ས་ ལུས་ སྤྱོད་ གཙོ་བོ་␣ར་ སྟོན །།"
msgstr "The first one teaches mainly activities of the body."

msgctxt "9633aa39dd244d3593ae24303cddef15"
msgid "གཉིས་པ་␣ས་ ངག་ སྤྱོད་ གཙོ་བོ་␣ར་ སྟོན །།"
msgstr "The second one teaches mainly activities of the speech."

msgctxt "84f6ce77fa3b43bcad604f543d208476"
msgid "གསུམ་པ་␣འི་ སེམས་ སྤྱོད་ གཙོ་བོ་␣ར་ སྟོན །།"
msgstr "The third one teaches mainly activities of the mind."

msgctxt "2c3a1b424ff4403d99ed77ba988844f3"
msgid "བཞི་པ་␣ས་ ལྷན་སྐྱེས་ འབའ་ཞིག་ གོ །"
msgstr "The fourth one is only about co-emergence."

msgctxt "ddd893ee9fa14581b389a2c77c3de972"
msgid "བགྱི་བ་ གསུངས་པ་␣ས །"
msgstr "In the Gyiva it is said:"

msgctxt "9db13861a8de4565ac56d6b0a114b5f3"
msgid ""
"བྱ་བ་␣འི་ རྒྱུད་ ཀྱིས་ ཁྲུས་ དང་ གཙང་སྦྲ་ ལ་སོགས་པ་ ལུས་ ཀྱི་ སྤྱོད་ལམ་ "
"གཙོ་བོ་␣ར་ སྟོན །"
msgstr ""
"Kriya Tantra teaches mainly activities of the body such as washing and "
"cleanliness, and so on."

msgctxt "a33bae745ca94fa48ff75baf961bdaa8"
msgid ""
"སྤྱོད་པ་␣འི་ རྒྱུད་ ཀྱིས་ འདོན་ ཟློས་པ་ ལ་སོགས་པ་ ངག་ གི་ སྤྱོད་པ་ "
"གཙོ་བོ་␣ར་ སྟོན །"
msgstr ""
"Upaya Tantra teaches mainly activities of the speech such as spirits and "
"recitations, and so on."

msgctxt "67001ac2d1e74e2d814c6e1fb6a5c4a9"
msgid ""
"རྣལ་འབྱོར་ གྱི་ རྒྱུད་ ནས་ ལམ་ བསྒོམས་པ་ ལ་སོགས་པ་ སེམས་ ཀྱི་ སྤྱོད་པ་ "
"གཙོ་བོ་␣ར་ སྟོན །"
msgstr ""
"Yoga Tantra mainly teaches activities of the mind such as meditation on the "
"path and so on."

msgctxt "85821cc3782c4356893c1c93e77f958d"
msgid ""
"རྣལ་འབྱོར་ བླ་ ན་ མེད་པ་␣འི་ རྒྱུད་ ནས་ དེ་ གསུམ་ དབྱེ་བ་ མེད་པ་␣འམ་ "
"ལྷན་ཅིག་ སྐྱེས་པ་␣འི་ ཡེ་ཤེས་ ངོ་སྤྲོད་པ་␣འི་ ཚུལ་ དུ་ སྟོན་པ་ ལགས །"
msgstr ""
"Anutara Tantra teaches in an introductory way co-emergent wisdom even if "
"there are none of those three Tantras."

msgctxt "56568e0d97f446cb860705d4cc92f6f2"
msgid ""
"དེ་ ལ་ རྣལ་འབྱོར་ བླ་ ན་ མེད་པ་␣འི་ རྒྱུད་ འདི་ ལ །  ཕ་ བླ་ ན་ མེད་པ་␣འི་ "
"རྒྱུད་ དང་ །  མ་ བླ་ ན་ མེད་པ་␣འི་ རྒྱུད་ འདི་ ཡིན །"
msgstr ""
"In Anuttara Yoga Tantra there are Father Anuttara Tantras and Mother "
"Anuttara Tantras. "

msgctxt "8aa4ebcd962c46b5b2639e890fb39449"
msgid ""
"དེ་ ཚན་གཅིག་ གིས་ བཤད་པ་ བྱེད་པ་␣འི་ དུས་ སུ །  ཕ་རྒྱུད་ མ་རྒྱུད་ ཀྱི་ "
"ཁྱད་པར་ དེ །"
msgstr ""
"When explaining through one particular group, the difference between Father "
"Tantra and Mother Tantra is -"

msgctxt "db8f6d156c0d43b4be804bc37bb913da"
msgid ""
"ཕ་␣འི་ དོན་ དུ་ བྱུང་ ཞིང་ ཕ་ ཤས་ ཆེ་བ་ ཕ་རྒྱུད་ དུ་ གྲགས་པ་ གསུམ་ དང་ "
"ལྡན་པ་ ནི་ ཕ་རྒྱུད་ ཡིན་ ལ །"
msgstr ""
"Occurred for the sake of the father it has predominantly male aspect and is "
"called Father Tantra imbued with these three points it is a Father Tantra. "

msgctxt "cb2bf345df3a45f3bdb2ae928925c857"
msgid ""
"མ་␣འི་ དོན་ དུ་ བྱུང་ ཞིང་ མ་ ཤས་ ཆེ་བ་ མ་␣འི་ རྒྱུད་ དུ་ གྲགས་པ་ གསུམ་ དང་ "
"ལྡན་པ་␣ས་ ན་"
msgstr ""
"Occurred for the sake of the mother it has a predominantly feminine aspect "
"and is called Mother Tantra imbued with these three points it is a Mother "
"Tantra. "

msgctxt "c95d1567620d4db9a7f48b1b03c19494"
msgid ""
"མ་རྒྱུད་ ཡིན་ ཟེར་བ་ ཡོད་ ན་ ཡང་ །  སྤྱན་སྔ་␣འི་ བཞེད་ ཀྱིས་ སྤྱིར་ "
"རྡོ་རྗེ་␣འི་ ལུས་ འདི་ གཏན་ ལ་ འབེབས་པ་␣འི་ ཐབས་ སུ་ གཅིག་ སྟེ །  རླུང་ "
"གཙོ་བོ་␣ར་ སྟོན་པ་ ཕ་རྒྱུད །  རྩ་ གཙོ་བོ་␣ར་ སྟོན་པ་ མ་རྒྱུད་ དུ་ འོང་བ་ "
"ཡིན་ གསུངས །"
msgstr ""
"Even though they are named so, generally describing the Vajra Body there is "
"one way of understanding the difference: loong is mainly taught in Father "
"Tantra, and channels are mainly taught in Mother Tantra."

msgctxt "1ebaab23cfe7491296efefae234298e8"
msgid ""
"དེ་ཡང་ སྤྱིར་ རྡོ་རྗེ་␣འི་ ལུས་ འདི་ ལ་ སྤྱི་བོ་␣འི་ གཙུག་ ནས་ རྐང་པ་␣འི་ "
"མཐིལ་ ཡན་ཆད་ ལ་རྩ་ སྟོང་ཕྲག་ བདུན་ཅུ་ རྩ་ གཉིས །"
msgstr ""
"Furthermore, generally speaking, in the vajra body there are seventy-two "
"thousand channels from the crown of the head to the sole of the foot. "

msgctxt "ec79666dea394c0d8f9497b2af26b56a"
msgid "དེ་␣འི་ ནང་ ནས་ གཙོ་བོ་␣ར་ གྱུར་པ་ སུམ་ཅུ་རྩ་གཉིས །"
msgstr "Out of them, there are thirty-two main channels. "

msgctxt "a0cc1440d15746a5b22411c02cfae41f"
msgid "དེ་␣འི་ ནང་ ནས་ གཙོ་བོ་␣ར་ གྱུར་པ་ རྩ་ གསུམ་ དང་ འཁོར་ལོ་ རྣམ་པ་ བཞི །"
msgstr "Out of them there are three main channels and four chakras. "

msgctxt "370e9b81e8e1460897c343083e9caa25"
msgid ""
"དེ་ ལ་རྩ་ གསུམ་ ནི །  རོ་ མ །  རྐྱང་མ །  ཀུན་ འད་␣ར་ མ་ ཞེས་ ཟེར །  གཡས་པ་ "
"དང་ གཡོན་པ་ དང་ དབུས་མ་ ཞེས་ ཟེར །"
msgstr ""
"The three channels are called rasana, lalana, and avadhuti, or the right "
"channel, the left channel, and the central channel."

msgctxt "b7eeb176eeb64e15aa2241f771ce11a4"
msgid ""
"དེ་ ལ་རྩ་ གསུམ་ གྱི་ དབུ་མ་ དེ་ དྷུ་ ཏཱི་ ཁོང་པ་␣འི་ ནང་ དྲང་པོ་ ན་ ཡར་ ལ་ "
"སྲོག་ཤིང་ གི་ ཚུལ་ དུ་ གནས་པ་ ལགས །"
msgstr ""
"The Central channel or Avadhuti, being straight and above inside of the "
"body, abides in the mode of life tree."

msgctxt "7fe57539b12d45be9df46f7994008734"
msgid ""
"དེ་␣འི་ ཡར་ སྣ་ དེ་ སྤྱི་བོ་␣འི་ གཙུག་ ཏུ་ ཡི་གེ་ ཧཾ་ མགོ་ ཐུར་ དུ་ "
"བསྟན་པ་བ་␣འི་ ནུ་མ་ ལྟ་བུ་ ཞིག་ ཡོད་པ་ ལ་ གཏད་ ཅིང་ །  དེ་␣འི་ མར་ སྣ་ "
"གསང་བ་␣འི་ གནས་ སུ་ ཟུག་ ནས་ ཡོད་པ་ ཡིན །"
msgstr ""
"Its upper end located at the crown of the head has the syllable HAM. Its "
"head is explained to be facing downwards like the breast of the cow pointing"
" downwards. Its lower end is penetrated into the genital area. "

msgctxt "b1f56dcdd2f04a0fa757ee8f3632df81"
msgid ""
"གཡས་གཡོན་ གཉིས་ ཀྱི་ ཡར་ སྣ་ ཀླད་པ་␣འི་ སྟེང་ དུ་ འཁྱོག་ ཅིང་ མར་ སྣ་ "
"ལྟེ་འོག་ སོ་␣ར་ བཞི་␣ར་ དབུ་མ་ ལ་ཁ་ སྤྲད་ ནས་ ཡི་གེ་ ཆ་␣འི་ དབྱིབས་ སུ་ "
"གནས་པ་ ལགས །"
msgstr ""
"The upper ends of both left and right channels are bent in the brain, the "
"lower ends are four inches lower than the navel where they meet the Central "
"channel. This intersection has the form of the letter Cha. "

msgctxt "97983226ae3d4fe6ba66e5b61442ddd7"
msgid "དེ་ཡང་ ཁ་དོག་ དམར་པོ་ མདའ་ སྨྱུག་ ཙམ་ དུ་ གནས་པ་ ལགས །"
msgstr "They are red and are just like bamboo arrows."

msgctxt "c6f4d3703a90484a8841a768f5d1b31d"
msgid ""
"འཁོར་ལོ་ བཞི་␣འི་ དབང་ དུ་ བྱས་ ན །  ལྟེ་བ་␣ར་ སྤྲུལ་པ་␣འི་ འཁོར་ལོ །  "
"སྙིང་ག་␣ར་ ཆོས་ ཀྱི་ འཁོར་ལོ །  མགྲིན་པ་␣ར་ ལོངས་སྤྱོད་ ཀྱི་ འཁོར་ལོ །  "
"སྤྱི་བོ་␣ར་ བདེ་བ་ ཆེན་པོ་␣འི་ འཁོར་ལོ་ དང་ བཞི་ ལགས །"
msgstr ""
"In terms of four chakras: in the navel - emanation chakra, in the heart "
"center - Dharma chakra, in the throat - enjoyment chakra, in the crown - "
"chakra of great bliss."

msgctxt "cfacd1afb4c64bde8781d967b2e0fc34"
msgid ""
"གོང་ གི་ རྩ་ གསུམ་པོ་ དེ་␣འི་ གཡས་པ་ རྟོག་པ་␣འི་ རྩ་ ཡིན་ ལ །  གཡོན་པ་ མི་ "
"རྟོག་པ་ ཡིན །"
msgstr ""
"Of the three channels described above, the right one is the channel of "
"thought, the left one is the channel of no thought. "

msgctxt "d460ce7ac86d45b380174d6ef482dcc9"
msgid ""
"ཡང་ གཡས་པ་ ཐབས་ ཡིན །  གཡོན་པ་ ཤེས་རབ །  དབུ་མ་ ཐབས་ཤེས་ རབ་ དབྱེ་བ་ "
"མེད་པ་␣འི་ ཟུང་ དུ་ འཇུག་པ་␣འི་ རྩ་␣ར་ ཡོད་པ་ ཡིན་ ཏེ །"
msgstr ""
"Moreover, the right one is the method, the left one is the wisdom, and the "
"central one has no differentiation between method and wisdom and is the "
"channel that combines both of them."

msgctxt "e91fc1a6ddb84589b78f5c6e83d99686"
msgid "དེ་ལྟར་ ཡང་ །"
msgstr "From Marpa's Sung Bum:"

msgctxt "21a859067f5f432585b340a237763eb5"
msgid "རྐྱང་མ་ ཤེས་རབ་ རང་བཞིན་ ལ །།"
msgstr "Lalana - in the nature of wisdom,"

msgctxt "5a7a40637ab6426ab409498a77cb859c"
msgid "རོ་ མ་ ཐབས་ ཀྱི་ ཡང་དག་ གནས །།"
msgstr "Rasana abides in an extreme purity of the method,"

msgctxt "513d8a13458d4cb3ba5a9aafbef01c03"
msgid "ཀུན་ འད་␣ར་ མ་ ནི་ དབུས་ གནས་ སུ །།"
msgstr "Avadhuti, which is located in the center,"

msgctxt "ed00c73ad0964fe2a6a94307a0cb4b22"
msgid "གཟུང་ དང་ འཛིན་པ་ རྣམ་པ་␣ར་ སྤངས །།"
msgstr "Abandons grasped and grasping."

msgctxt "eb6c7fe5d3344eabbad5030c25e31d4e"
msgid "བགྱི་བ་ གསུངས །"
msgstr "བགྱི་བ་ གསུངས"

msgctxt "f613ff287c824b34b380038179ae602f"
msgid "དེས་ན་ རླུང་ གི་ དབང་ དུ་ བགྱིས་ ན །"
msgstr "Thus in terms of loong:"

msgctxt "2dac7bdc0cf04606bc9e47360c9cd358"
msgid "ལྔ་ ཡི་ བདག་ཉིད་ བཅུ་ མིང་ཅན །།"
msgstr "Five by nature and has ten names."

msgctxt "c35f658cf5d94436aad52c8733b45f18"
msgid "གསུངས་པ་␣ས །  རྩ་བ་␣འི་ རླུང་ ལྔ་ དང་ ཡན་ལག་ གི་ རླུང་ ལྔ་ ལ་སོགས་པ །"
msgstr ""
"By saying this, there are five basic loongs and five ancillary loongs, and "
"so on. "

msgctxt "8c533e505c4946fc8bf27d97572c6b8f"
msgid ""
"གཡས་ ནས་ རྒྱུ་བ་ དང་ །  གཡོས་ ནས་ རྒྱུ་བ་ དང་ །  གཉིས་ཀ་ ནས་ རྒྱུ་བ་ དང་ །  "
"གཉིས་ཀ་ ནས་ དལ་བར་ རྒྱུ་བ་ དང་ བཞི་ ཡིན་ ཏེ །"
msgstr ""
"Four types of movement of the loong: moving from the right side, moving from"
" the left side, moving from both sides, and moving gently from both sides."

msgctxt "da306af8022c47869d2c91d98b1bcb6b"
msgid "དེ་ལྟར་ ཡང་ །  གཡས་ དང་ གཡོན་ དང་ གཉིས་ཀ་ དང་ །"
msgstr "According to that: right, left, both, and"

msgctxt "c2b30b1f1aa445e8b335427c72f03042"
msgid "དལ་བར་ རྒྱུ་ དང་ རྣམ་པ་ བཞི་␣འོ །།"
msgstr "Gently moving they are four."
