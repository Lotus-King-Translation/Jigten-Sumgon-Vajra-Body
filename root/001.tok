དེ་ལྟ་ བུ འི་ རྒྱུད་སྡེ་ བཞི་པོ་ དེ་ རང་ གང་ཡིན་ སྙམ་ ན །_ བྱ་བ འི་ རྒྱུད་ དང་ །_ སྤྱོད་པ འི་ རྒྱིད་ དང་ །_ རྣལ་འབྱོར་ གྱི་ རྒྱུད་ དང་ བླ་མེད་ རྒྱུད །དང་པོ ས་ ལུས་ སྤྱོད་ གཙོ་བོ ར་ སྟོན །།གཉིས་པ ས་ ངག་ སྤྱོད་ གཙོ་བོ ར་ སྟོན །།གསུམ་པ འི་ སེམས་ སྤྱོད་ གཙོ་བོ ར་ སྟོན །།བཞི་པ ས་ ལྷན་སྐྱེས་ འབའ་ཞིག་ གོ །བགྱི་བ་ གསུངས་པ ས །བྱ་བ འི་ རྒྱུད་ ཀྱིས་ ཁྲུས་ དང་ གཙང་སྦྲ་ ལ་སོགས་པ་ ལུས་ ཀྱི་ སྤྱོད་ལམ་ གཙོ་བོ ར་ སྟོན །སྤྱོད་པ འི་ རྒྱུད་ ཀྱིས་ འདོན་ ཟློས་པ་ ལ་སོགས་པ་ ངག་ གི་ སྤྱོད་པ་ གཙོ་བོ ར་ སྟོན །རྣལ་འབྱོར་ གྱི་ རྒྱུད་ ནས་ ལམ་ བསྒོམས་པ་ ལ་སོགས་པ་ སེམས་ ཀྱི་ སྤྱོད་པ་ གཙོ་བོ ར་ སྟོན །རྣལ་འབྱོར་ བླ་ ན་ མེད་པ འི་ རྒྱུད་ ནས་ དེ་ གསུམ་ དབྱེ་བ་ མེད་པ འམ་ ལྷན་ཅིག་ སྐྱེས་པ འི་ ཡེ་ཤེས་ ངོ་སྤྲོད་པ འི་ ཚུལ་ དུ་ སྟོན་པ་ ལགས །དེ་ ལ་ རྣལ་འབྱོར་ བླ་ ན་ མེད་པ འི་ རྒྱུད་ འདི་ ལ །_ ཕ་ བླ་ ན་ མེད་པ འི་ རྒྱུད་ དང་ །_ མ་ བླ་ ན་ མེད་པ འི་ རྒྱུད་ འདི་ ཡིན །དེ་ ཚན་གཅིག་ གིས་ བཤད་པ་ བྱེད་པ འི་ དུས་ སུ །_ ཕ་རྒྱུད་ མ་རྒྱུད་ ཀྱི་ ཁྱད་པར་ དེ །ཕ འི་ དོན་ དུ་ བྱུང་ ཞིང་ ཕ་ ཤས་ ཆེ་བ་ ཕ་རྒྱུད་ དུ་ གྲགས་པ་ གསུམ་ དང་ ལྡན་པ་ ནི་ ཕ་རྒྱུད་ ཡིན་ ལ །མ འི་ དོན་ དུ་ བྱུང་ ཞིང་ མ་ ཤས་ ཆེ་བ་ མ འི་ རྒྱུད་ དུ་ གྲགས་པ་ གསུམ་ དང་ ལྡན་པ ས་ ན་མ་རྒྱུད་ ཡིན་ ཟེར་བ་ ཡོད་ ན་ ཡང་ །_ སྤྱན་སྔ འི་ བཞེད་ ཀྱིས་ སྤྱིར་ རྡོ་རྗེ འི་ ལུས་ འདི་ གཏན་ ལ་ འབེབས་པ འི་ ཐབས་ སུ་ གཅིག་ སྟེ །_ རླུང་ གཙོ་བོ ར་ སྟོན་པ་ ཕ་རྒྱུད །_ རྩ་ གཙོ་བོ ར་ སྟོན་པ་ མ་རྒྱུད་ དུ་ འོང་བ་ ཡིན་ གསུངས །དེ་ཡང་ སྤྱིར་ རྡོ་རྗེ འི་ ལུས་ འདི་ ལ་ སྤྱི་བོ འི་ གཙུག་ ནས་ རྐང་པ འི་ མཐིལ་ ཡན་ཆད་ ལ་རྩ་ སྟོང་ཕྲག་ བདུན་ཅུ་ རྩ་ གཉིས །དེ འི་ ནང་ ནས་ གཙོ་བོ ར་ གྱུར་པ་ སུམ་ཅུ་རྩ་གཉིས །དེ འི་ ནང་ ནས་ གཙོ་བོ ར་ གྱུར་པ་ རྩ་ གསུམ་ དང་ འཁོར་ལོ་ རྣམ་པ་ བཞི །དེ་ ལ་རྩ་ གསུམ་ ནི །_ རོ་ མ །_ རྐྱང་མ །_ ཀུན་ འད ར་ མ་ ཞེས་ ཟེར །_ གཡས་པ་ དང་ གཡོན་པ་ དང་ དབུས་མ་ ཞེས་ ཟེར །དེ་ ལ་རྩ་ གསུམ་ གྱི་ དབུ་མ་ དེ་ དྷུ་ ཏཱི་ ཁོང་པ འི་ ནང་ དྲང་པོ་ ན་ ཡར་ ལ་ སྲོག་ཤིང་ གི་ ཚུལ་ དུ་ གནས་པ་ ལགས །དེ འི་ ཡར་ སྣ་ དེ་ སྤྱི་བོ འི་ གཙུག་ ཏུ་ ཡི་གེ་ ཧཾ་ མགོ་ ཐུར་ དུ་ བསྟན་པ་བ འི་ ནུ་མ་ ལྟ་བུ་ ཞིག་ ཡོད་པ་ ལ་ གཏད་ ཅིང་ །_ དེ འི་ མར་ སྣ་ གསང་བ འི་ གནས་ སུ་ ཟུག་ ནས་ ཡོད་པ་ ཡིན །གཡས་གཡོན་ གཉིས་ ཀྱི་ ཡར་ སྣ་ ཀླད་པ འི་ སྟེང་ དུ་ འཁྱོག་ ཅིང་ མར་ སྣ་ ལྟེ་འོག་ སོ ར་ བཞི ར་ དབུ་མ་ ལ་ཁ་ སྤྲད་ ནས་ ཡི་གེ་ ཆ འི་ དབྱིབས་ སུ་ གནས་པ་ ལགས །དེ་ཡང་ ཁ་དོག་ དམར་པོ་ མདའ་ སྨྱུག་ ཙམ་ དུ་ གནས་པ་ ལགས །འཁོར་ལོ་ བཞི འི་ དབང་ དུ་ བྱས་ ན །_ ལྟེ་བ ར་ སྤྲུལ་པ འི་ འཁོར་ལོ །_ སྙིང་ག ར་ ཆོས་ ཀྱི་ འཁོར་ལོ །_ མགྲིན་པ ར་ ལོངས་སྤྱོད་ ཀྱི་ འཁོར་ལོ །_ སྤྱི་བོ ར་ བདེ་བ་ ཆེན་པོ འི་ འཁོར་ལོ་ དང་ བཞི་ ལགས །གོང་ གི་ རྩ་ གསུམ་པོ་ དེ འི་ གཡས་པ་ རྟོག་པ འི་ རྩ་ ཡིན་ ལ །_ གཡོན་པ་ མི་ རྟོག་པ་ ཡིན །ཡང་ གཡས་པ་ ཐབས་ ཡིན །_ གཡོན་པ་ ཤེས་རབ །_ དབུ་མ་ ཐབས་ཤེས་ རབ་ དབྱེ་བ་ མེད་པ འི་ ཟུང་ དུ་ འཇུག་པ འི་ རྩ ར་ ཡོད་པ་ ཡིན་ ཏེ །དེ་ལྟར་ ཡང་ །རྐྱང་མ་ ཤེས་རབ་ རང་བཞིན་ ལ །།རོ་ མ་ ཐབས་ ཀྱི་ ཡང་དག་ གནས །།ཀུན་ འད ར་ མ་ ནི་ དབུས་ གནས་ སུ །།གཟུང་ དང་ འཛིན་པ་ རྣམ་པ ར་ སྤངས །།བགྱི་བ་ གསུངས །དེས་ན་ རླུང་ གི་ དབང་ དུ་ བགྱིས་ ན །ལྔ་ ཡི་ བདག་ཉིད་ བཅུ་ མིང་ཅན །།གསུངས་པ ས །_ རྩ་བ འི་ རླུང་ ལྔ་ དང་ ཡན་ལག་ གི་ རླུང་ ལྔ་ ལ་སོགས་པ །གཡས་ ནས་ རྒྱུ་བ་ དང་ །_ གཡོས་ ནས་ རྒྱུ་བ་ དང་ །_ གཉིས་ཀ་ ནས་ རྒྱུ་བ་ དང་ །_ གཉིས་ཀ་ ནས་ དལ་བར་ རྒྱུ་བ་ དང་ བཞི་ ཡིན་ ཏེ །དེ་ལྟར་ ཡང་ །_ གཡས་ དང་ གཡོན་ དང་ གཉིས་ཀ་ དང་ །དལ་བར་ རྒྱུ་ དང་ རྣམ་པ་ བཞི འོ །།